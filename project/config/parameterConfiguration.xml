<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <AlignedSize>4096</AlignedSize>
    <UnitSize>8192</UnitSize>
    <BlockSize>1048576</BlockSize>
    <!-- 64 KiB -->
    <!--1048576-->
    <!--8388608-->
    <!--67108864-->
    <DatanodeNumPerCluster>8</DatanodeNumPerCluster>
    <ClusterNum>6</ClusterNum>
    <CoordinatorIP>10.10.1.2</CoordinatorIP>
    <CoordinatorPort>55555</CoordinatorPort>
    <!-- AppendMode: REP_MODE; UNILRC_MODE; CACHED_MODE -->
    <AppendMode>UNILRC_MODE</AppendMode>
    <alpha>2</alpha>
    <!-- LRC: UniLRC; AzureLRC; OptimalLRC; UniformLRC; XueLRC; SplitParityLRC; CordXueLRC -->
    <CodeType>SplitParityLRC</CodeType>
    <k>10</k>
    <r>2</r>  //是全局校验块数量
    <z>2</z>  //是本地校验块数量
    <!-- 0 = non-deterministic placement RNG; non-zero = reproducible RandomLRC / encode Ran placement for same seed+stripe_id+topology -->
    <PlacementRandomSeed>1</PlacementRandomSeed>
    <!-- ClientStripeNum: SET 阶段放置条带数；stripe_id 0 .. ClientStripeNum-1 -->
    <ClientStripeNum>100</ClientStripeNum>
    <!-- CordRequestTimeoutSec: CoRD 单次 update 总超时（秒），含 plan、upload、跨 cluster 传输 -->
    <CordRequestTimeoutSec>120</CordRequestTimeoutSec>
