<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <AlignedSize>4096</AlignedSize>
    <UnitSize>8192</UnitSize>
    <BlockSize>65536</BlockSize>
    <!--1048576-->
    <!--8388608-->
    <!--67108864-->
    <DatanodeNumPerCluster>8</DatanodeNumPerCluster>
    <ClusterNum>6</ClusterNum>
    <CoordinatorIP>10.10.1.2</CoordinatorIP>
    <CoordinatorPort>55555</CoordinatorPort>
    <!-- AppendMode: REP_MODE; UNILRC_MODE; CACHED_MODE -->
    <AppendMode>UNILRC_MODE</AppendMode>
    <alpha>2</alpha>
    <!-- LRC: UniLRC; AzureLRC; OptimalLRC; UniformLRC; XueLRC -->
    <CodeType>RandomLRC</CodeType>
    <k>10</k>
    <r>2</r>  //是全局校验块数量
    <z>2</z>  //是本地校验块数量
    <!-- main_client: how many stripes to write (Client::set loop); change here or override in config.h default -->
    <ClientStripeNum>10</ClientStripeNum>
    <!-- Parix planParixFullStripe: master data block in [0,k). Non-zero = mt19937(seed) for reproducible sequence across calls/runs; 0 = legacy rand_num per call -->
    <ParixPlacementSeed>17</ParixPlacementSeed>
