#!/usr/bin/env bash
# Bandwidth matrix for limit_bw_matrix.sh / limit_all_bw_matrix.sh
#
# Units: MB/s (megabytes per second), TABLE II — "Bandwidth measurements in Asia regions".
# Region index matches CLUSTER_IPS in limit_bw_matrix.sh (proxy IP per cluster):
#   0=TYO  1=MEL  2=SG  3=SEO  4=JAK  5=HK  6=BKK  7=TPE  8=DEL  9=BOM
#
# Construction (for tc symmetric egress matrix):
#   - Diagonal [i,i]: intra-region MB/s from TABLE II (0-5); 6-9 use placeholder ~42 MB/s.
#   - Off-diagonal: 125 MB/s (cross-region cap).
#
# Linux tc HTB uses Mbit/s ("mbit"). Convert MB/s → Mbit/s for tc by multiplying
# bytes→bits factor (default 8). Override with BW_MATRIX_MB_PER_SEC_TO_TC_MBIT.

readonly BW_CLUSTER_NUM="${BW_CLUSTER_NUM:-10}"
readonly BW_MATRIX_MB_PER_SEC_TO_TC_MBIT="${BW_MATRIX_MB_PER_SEC_TO_TC_MBIT:-8}"

# Symmetric 10×10, row-major, units: MB/s
readonly BW_MATRIX_MB_PER_SEC=(
  43.62 125 125 125 125 125 125 125 125 125
  125 51.33 125 125 125 125 125 125 125 125
  125 125 39.68 125 125 125 125 125 125 125
  125 125 125 32.54 125 125 125 125 125 125
  125 125 125 125 46.82 125 125 125 125 125
  125 125 125 125 125 35.87 125 125 125 125
  125 125 125 125 125 125 42.00 125 125 125
  125 125 125 125 125 125 125 42.00 125 125
  125 125 125 125 125 125 125 125 42.00 125
  125 125 125 125 125 125 125 125 125 42.00
)

_get_bw_matrix_index() {
  local src=$1 dst=$2
  if ! [[ "$src" =~ ^[0-9]+$ && "$dst" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if (( src < 0 || dst < 0 || src >= BW_CLUSTER_NUM || dst >= BW_CLUSTER_NUM )); then
    return 1
  fi
  echo $((src * BW_CLUSTER_NUM + dst))
}

# strip bandwidth from matrix in MB/s (for logging / display)
get_bw_matrix_mb_per_sec() {
  local src=$1 dst=$2
  local idx
  idx="$(_get_bw_matrix_index "$src" "$dst")" || return 1
  local m="${BW_MATRIX_MB_PER_SEC[$idx]:-}"
  [[ -n "$m" ]] || return 1
  printf '%s' "$m"
}

# tc HTB rate in Mbit/s (numeric string suitable for "XXXmbit")
get_bw_tc_mbit_rate() {
  local src=$1 dst=$2
  local idx
  idx="$(_get_bw_matrix_index "$src" "$dst")" || return 1
  local mbs="${BW_MATRIX_MB_PER_SEC[$idx]:-}"
  [[ -n "$mbs" ]] || return 1
  awk -v x="$mbs" -v s="$BW_MATRIX_MB_PER_SEC_TO_TC_MBIT" 'BEGIN { printf "%.6f", x * s }'
}

# Deprecated alias: historically misnamed; returns Mbit/s for tc, not MB/s.
get_bw_mbps() {
  get_bw_tc_mbit_rate "$@"
}
